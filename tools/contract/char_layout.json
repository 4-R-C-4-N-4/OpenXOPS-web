  "source": "src/d3dgraphics-opengl.cpp:2707-2786 (Draw2DTextureFontText); src/gamemain.cpp:3041-3110,3195-3198",
  "texture_size_reference": [
    512,
    512
  ],
  "texture_size_note": "The engine only uses normalised UVs (1/16 per cell), so any square size works. 512x512 gives 32 px cells. Power-of-two is recommended (see ASSET-CONTRACT.md 1.6).",
  "grid": {
    "cols": 16,
    "rows": 16,
    "cell_px_at_512": 32,
    "code_to_cell": "col = code % 16, row = code / 16 (code = unsigned byte 0..255)",
    "uv_per_cell": 0.0625,
    "uv_origin": "top-left; v grows downward",
    "cell_drawn_whole": true,
    "notes": [
      "Code 0x00 is never drawn (strlen terminator).",
      "Space 0x20 is drawn as a quad, so its cell must be fully transparent.",
      "Glyphs are drawn at many sizes and aspect ratios (10x14 to 60x42 px at 640x480 reference), with GL_LINEAR filtering and no mipmaps."
    ]
  },
  "colour": "Vertex colour modulates the texel (GL_MODULATE). Glyphs should be white, with the glyph shape in alpha. HUD frame cells are drawn with colour (1,1,1,0.5).",
  "glyph_ranges": [
    {
      "range": [
        32,
        126
      ],
      "purpose": "printable ASCII text (menus, HUD numbers, weapon names, mission names, fps counter)",
      "required": true
    },
    {
      "range": [
        1,
        31
      ],
      "purpose": "never referenced by engine string literals",
      "required": false
    },
    {
      "range": [
        127,
        175
      ],
      "purpose": "not referenced by the engine; reachable only from user/mission strings",
      "required": false
    },
    {
      "range": [
        191,
        255
      ],
      "purpose": "0xBF and 0xCA-0xFF are not referenced by the engine (only 0xC0-0xC9 and 0xD0-0xD2 are used); reachable from user strings",
      "required": false
    }
  ],
