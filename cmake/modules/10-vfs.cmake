# Standalone component; game call sites are deliberately not redirected yet.
find_package(ZLIB REQUIRED)
find_package(Iconv REQUIRED)
add_library(openxops_vfs STATIC ${SRC}/platform/vfs.cpp)
target_include_directories(openxops_vfs PUBLIC ${SRC}/platform)
target_link_libraries(openxops_vfs PUBLIC ZLIB::ZLIB Iconv::Iconv)
target_compile_options(openxops_vfs PRIVATE -Wall -Wextra)
target_link_libraries(openxops PRIVATE openxops_vfs)
add_executable(vfs_test ${CMAKE_CURRENT_SOURCE_DIR}/tests/vfs_test.cpp)
target_link_libraries(vfs_test PRIVATE openxops_vfs)
if(OPENXOPS_SANITIZE)
  foreach(t openxops_vfs vfs_test)
    target_compile_options(${t} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined)
    target_link_options(${t} PRIVATE -fsanitize=address,undefined)
  endforeach()
endif()
add_test(NAME vfs COMMAND vfs_test)
if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/xopsdata/xops096.zip")
  add_test(NAME vfs_real_pack COMMAND vfs_test "${CMAKE_CURRENT_SOURCE_DIR}/xopsdata/xops096.zip")
endif()
